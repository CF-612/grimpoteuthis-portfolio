# Keep the public repository focused on the runnable site.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/DEPLOYMENT.md
!/docs/
!/LICENSE
!/ASSET_LICENSE.md
!/RELEASE_REVIEW.md
!/package.json
!/site.config.json
!/build-local-release.cjs
!/serve-local.js
!/scripts/
!/design/
/scripts/*
!/scripts/check-release.cjs
/design/*
!/design/index-v2.html
!/design/finalize-preview.cjs
!/design/data.js
!/design/design.js
!/design/intro.js
!/design/intro-flow.js
!/design/storyboard.html
!/design/design.css
!/design/refinement.css
!/design/polish.css
!/design/editorial.css
!/design/intro.css
!/design/detail.css
!/design/games/
!/design/assets/
/design/assets/*
!/design/assets/authored/
!/design/assets/games/
!/design/assets/thumbs/
!/design/assets/stage/
!/design/assets/originals/
!/design/assets/fonts/
!/design/assets/media/
!/design/assets/cloud-silk-v21.svg
!/design/assets/skirt-pass-v11.svg
!/design/assets/octopus.png
!/design/assets/wordmark-stacked-v6.svg
!/design/assets/wordmark-hero-v13.svg
!/design/assets/wordmark-hero-v14.svg
!/design/assets/cloud-puff-*.svg
/design/assets/originals/*
